<!-- NICHQ Vanderbilt Assessment Scale—TEACHER Informant  (Stage-2 extraction)
     A task is a single page image. Turn on the page(s) actually shown on
     the scan (both, if the scan spans a page break); only those questions
     appear. Questions on pages left off are recorded as "Not Available"
     in post-processing. Symptoms 0-3; Performance 1-5; plus Blank. -->
<View>
  <View style="display:flex;">

    <!-- Left panel (stays in view): scanned page with zoom/pan/rotate -->
    <View style="flex:55%; align-self:flex-start; position:sticky; top:0; padding-right:1em;">
      <Image name="image" value="$image" zoom="true" zoomControl="true"
             rotateControl="true" width="100%"/>
    </View>

    <!-- Right panel (scrolls independently): extraction fields -->
    <View style="flex:45%; overflow-y:auto; max-height:90vh; font-size:12px;">
      <!-- Compact styling: shrink radio controls so the long forms fit -->
      <Style>
        .ant-radio-button-wrapper { height:22px !important; line-height:20px !important; padding:0 8px !important; font-size:12px !important; }
        .ant-radio-wrapper { font-size:12px !important; margin-right:8px !important; }
        .lsf-choices { gap:2px !important; }
      </Style>
      <Header value="NICHQ Vanderbilt Assessment Scale—TEACHER Informant" style="font-size:15px; margin:0 0 4px 0;"/>
      <Text name="filename" value="File: $filename"/>
      <Text name="doc_id" value="Doc ID: $doc_id"/>

      <Header value="Which page(s) are on this scan?" size="4" style="font-size:14px; margin:12px 0 2px 0;"/>
      <Text name="page_hint" value="Turn on every page visible on the scan (both if it spans a page break). Page 1 = symptoms 1–31   ·   Page 2 = symptoms 32–35 + performance" style="color:#6b7280; font-size:11px;"/>
      <Choices name="visible_pages" toName="image" choice="multiple" required="true" showInline="true">
        <Choice value="Page 1"/><Choice value="Page 2"/>
      </Choices>

      <!-- Page 1: symptoms 1–31 -->
      <View visibleWhen="choice-selected" whenTagName="visible_pages" whenChoiceValue="Page 1" style="border-left:3px solid #e3e6ec; padding-left:8px; margin-top:6px;">
      <Header value="Page 1" size="5" style="font-size:11px; color:#6b7280; margin:0 0 4px 0; text-transform:uppercase; letter-spacing:0.5px;"/>
      <Header value="Class Name/Period" size="4" style="font-size:14px; margin:12px 0 2px 0;"/>
      <TextArea name="class_name" toName="image" rows="1" maxSubmissions="1" placeholder="type the class name / period (leave empty if not shown)"/>
      <Header value="Medication status" size="4" style="font-size:14px; margin:12px 0 2px 0;"/>
      <Header value="Is this evaluation based on a time when the child was on medication?" size="5" style="font-size:12px; font-weight:600; margin:6px 0 0 0;"/>
      <Choices name="medication_status" toName="image" choice="single" showInline="true">
        <Choice value="was on medication"/><Choice value="was not on medication"/><Choice value="not sure"/><Choice value="Blank"/><Choice value="Not Available"/>
      </Choices>
      <Header value="Symptoms  (0=Never, 1=Occasionally, 2=Often, 3=Very Often)" size="4" style="font-size:14px; margin:12px 0 2px 0;"/>
      <Header value="1. Fails to give attention to details or makes careless mistakes in schoolwork" size="5" style="font-size:12px; font-weight:600; margin:6px 0 0 0;"/>
      <Choices name="symptom_1" toName="image" choice="single" showInline="true">
        <Choice value="0"/><Choice value="1"/><Choice value="2"/><Choice value="3"/><Choice value="Blank"/><Choice value="Not Available"/>
      </Choices>
      <Header value="2. Has difficulty sustaining attention to tasks or activities" size="5" style="font-size:12px; font-weight:600; margin:6px 0 0 0;"/>
      <Choices name="symptom_2" toName="image" choice="single" showInline="true">
        <Choice value="0"/><Choice value="1"/><Choice value="2"/><Choice value="3"/><Choice value="Blank"/><Choice value="Not Available"/>
      </Choices>
      <Header value="3. Does not seem to listen when spoken to directly" size="5" style="font-size:12px; font-weight:600; margin:6px 0 0 0;"/>
      <Choices name="symptom_3" toName="image" choice="single" showInline="true">
        <Choice value="0"/><Choice value="1"/><Choice value="2"/><Choice value="3"/><Choice value="Blank"/><Choice value="Not Available"/>
      </Choices>
      <Header value="4. Does not follow through on instructions and fails to finish schoolwork (not due to oppositional behavior or failure to understand)" size="5" style="font-size:12px; font-weight:600; margin:6px 0 0 0;"/>
      <Choices name="symptom_4" toName="image" choice="single" showInline="true">
        <Choice value="0"/><Choice value="1"/><Choice value="2"/><Choice value="3"/><Choice value="Blank"/><Choice value="Not Available"/>
      </Choices>
      <Header value="5. Has difficulty organizing tasks and activities" size="5" style="font-size:12px; font-weight:600; margin:6px 0 0 0;"/>
      <Choices name="symptom_5" toName="image" choice="single" showInline="true">
        <Choice value="0"/><Choice value="1"/><Choice value="2"/><Choice value="3"/><Choice value="Blank"/><Choice value="Not Available"/>
      </Choices>
      <Header value="6. Avoids, dislikes, or is reluctant to engage in tasks that require sustained mental effort" size="5" style="font-size:12px; font-weight:600; margin:6px 0 0 0;"/>
      <Choices name="symptom_6" toName="image" choice="single" showInline="true">
        <Choice value="0"/><Choice value="1"/><Choice value="2"/><Choice value="3"/><Choice value="Blank"/><Choice value="Not Available"/>
      </Choices>
      <Header value="7. Loses things necessary for tasks or activities (school assignments, pencils, or books)" size="5" style="font-size:12px; font-weight:600; margin:6px 0 0 0;"/>
      <Choices name="symptom_7" toName="image" choice="single" showInline="true">
        <Choice value="0"/><Choice value="1"/><Choice value="2"/><Choice value="3"/><Choice value="Blank"/><Choice value="Not Available"/>
      </Choices>
      <Header value="8. Is easily distracted by extraneous stimuli" size="5" style="font-size:12px; font-weight:600; margin:6px 0 0 0;"/>
      <Choices name="symptom_8" toName="image" choice="single" showInline="true">
        <Choice value="0"/><Choice value="1"/><Choice value="2"/><Choice value="3"/><Choice value="Blank"/><Choice value="Not Available"/>
      </Choices>
      <Header value="9. Is forgetful in daily activities" size="5" style="font-size:12px; font-weight:600; margin:6px 0 0 0;"/>
      <Choices name="symptom_9" toName="image" choice="single" showInline="true">
        <Choice value="0"/><Choice value="1"/><Choice value="2"/><Choice value="3"/><Choice value="Blank"/><Choice value="Not Available"/>
      </Choices>
      <Header value="10. Fidgets with hands or feet or squirms in seat" size="5" style="font-size:12px; font-weight:600; margin:6px 0 0 0;"/>
      <Choices name="symptom_10" toName="image" choice="single" showInline="true">
        <Choice value="0"/><Choice value="1"/><Choice value="2"/><Choice value="3"/><Choice value="Blank"/><Choice value="Not Available"/>
      </Choices>
      <Header value="11. Leaves seat in classroom or in other situations in which remaining seated is expected" size="5" style="font-size:12px; font-weight:600; margin:6px 0 0 0;"/>
      <Choices name="symptom_11" toName="image" choice="single" showInline="true">
        <Choice value="0"/><Choice value="1"/><Choice value="2"/><Choice value="3"/><Choice value="Blank"/><Choice value="Not Available"/>
      </Choices>
      <Header value="12. Runs about or climbs excessively in situations in which remaining seated is expected" size="5" style="font-size:12px; font-weight:600; margin:6px 0 0 0;"/>
      <Choices name="symptom_12" toName="image" choice="single" showInline="true">
        <Choice value="0"/><Choice value="1"/><Choice value="2"/><Choice value="3"/><Choice value="Blank"/><Choice value="Not Available"/>
      </Choices>
      <Header value="13. Has difficulty playing or engaging in leisure activities quietly" size="5" style="font-size:12px; font-weight:600; margin:6px 0 0 0;"/>
      <Choices name="symptom_13" toName="image" choice="single" showInline="true">
        <Choice value="0"/><Choice value="1"/><Choice value="2"/><Choice value="3"/><Choice value="Blank"/><Choice value="Not Available"/>
      </Choices>
      <Header value="14. Is “on the go” or often acts as if “driven by a motor”" size="5" style="font-size:12px; font-weight:600; margin:6px 0 0 0;"/>
      <Choices name="symptom_14" toName="image" choice="single" showInline="true">
        <Choice value="0"/><Choice value="1"/><Choice value="2"/><Choice value="3"/><Choice value="Blank"/><Choice value="Not Available"/>
      </Choices>
      <Header value="15. Talks excessively" size="5" style="font-size:12px; font-weight:600; margin:6px 0 0 0;"/>
      <Choices name="symptom_15" toName="image" choice="single" showInline="true">
        <Choice value="0"/><Choice value="1"/><Choice value="2"/><Choice value="3"/><Choice value="Blank"/><Choice value="Not Available"/>
      </Choices>
      <Header value="16. Blurts out answers before questions have been completed" size="5" style="font-size:12px; font-weight:600; margin:6px 0 0 0;"/>
      <Choices name="symptom_16" toName="image" choice="single" showInline="true">
        <Choice value="0"/><Choice value="1"/><Choice value="2"/><Choice value="3"/><Choice value="Blank"/><Choice value="Not Available"/>
      </Choices>
      <Header value="17. Has difficulty waiting in line" size="5" style="font-size:12px; font-weight:600; margin:6px 0 0 0;"/>
      <Choices name="symptom_17" toName="image" choice="single" showInline="true">
        <Choice value="0"/><Choice value="1"/><Choice value="2"/><Choice value="3"/><Choice value="Blank"/><Choice value="Not Available"/>
      </Choices>
      <Header value="18. Interrupts or intrudes on others (eg, butts into conversations/games)" size="5" style="font-size:12px; font-weight:600; margin:6px 0 0 0;"/>
      <Choices name="symptom_18" toName="image" choice="single" showInline="true">
        <Choice value="0"/><Choice value="1"/><Choice value="2"/><Choice value="3"/><Choice value="Blank"/><Choice value="Not Available"/>
      </Choices>
      <Header value="19. Loses temper" size="5" style="font-size:12px; font-weight:600; margin:6px 0 0 0;"/>
      <Choices name="symptom_19" toName="image" choice="single" showInline="true">
        <Choice value="0"/><Choice value="1"/><Choice value="2"/><Choice value="3"/><Choice value="Blank"/><Choice value="Not Available"/>
      </Choices>
      <Header value="20. Actively defies or refuses to comply with adult’s requests or rules" size="5" style="font-size:12px; font-weight:600; margin:6px 0 0 0;"/>
      <Choices name="symptom_20" toName="image" choice="single" showInline="true">
        <Choice value="0"/><Choice value="1"/><Choice value="2"/><Choice value="3"/><Choice value="Blank"/><Choice value="Not Available"/>
      </Choices>
      <Header value="21. Is angry or resentful" size="5" style="font-size:12px; font-weight:600; margin:6px 0 0 0;"/>
      <Choices name="symptom_21" toName="image" choice="single" showInline="true">
        <Choice value="0"/><Choice value="1"/><Choice value="2"/><Choice value="3"/><Choice value="Blank"/><Choice value="Not Available"/>
      </Choices>
      <Header value="22. Is spiteful and vindictive" size="5" style="font-size:12px; font-weight:600; margin:6px 0 0 0;"/>
      <Choices name="symptom_22" toName="image" choice="single" showInline="true">
        <Choice value="0"/><Choice value="1"/><Choice value="2"/><Choice value="3"/><Choice value="Blank"/><Choice value="Not Available"/>
      </Choices>
      <Header value="23. Bullies, threatens, or intimidates others" size="5" style="font-size:12px; font-weight:600; margin:6px 0 0 0;"/>
      <Choices name="symptom_23" toName="image" choice="single" showInline="true">
        <Choice value="0"/><Choice value="1"/><Choice value="2"/><Choice value="3"/><Choice value="Blank"/><Choice value="Not Available"/>
      </Choices>
      <Header value="24. Initiates physical fights" size="5" style="font-size:12px; font-weight:600; margin:6px 0 0 0;"/>
      <Choices name="symptom_24" toName="image" choice="single" showInline="true">
        <Choice value="0"/><Choice value="1"/><Choice value="2"/><Choice value="3"/><Choice value="Blank"/><Choice value="Not Available"/>
      </Choices>
      <Header value="25. Lies to obtain goods for favors or to avoid obligations (eg, “cons” others)" size="5" style="font-size:12px; font-weight:600; margin:6px 0 0 0;"/>
      <Choices name="symptom_25" toName="image" choice="single" showInline="true">
        <Choice value="0"/><Choice value="1"/><Choice value="2"/><Choice value="3"/><Choice value="Blank"/><Choice value="Not Available"/>
      </Choices>
      <Header value="26. Is physically cruel to people" size="5" style="font-size:12px; font-weight:600; margin:6px 0 0 0;"/>
      <Choices name="symptom_26" toName="image" choice="single" showInline="true">
        <Choice value="0"/><Choice value="1"/><Choice value="2"/><Choice value="3"/><Choice value="Blank"/><Choice value="Not Available"/>
      </Choices>
      <Header value="27. Has stolen items of nontrivial value" size="5" style="font-size:12px; font-weight:600; margin:6px 0 0 0;"/>
      <Choices name="symptom_27" toName="image" choice="single" showInline="true">
        <Choice value="0"/><Choice value="1"/><Choice value="2"/><Choice value="3"/><Choice value="Blank"/><Choice value="Not Available"/>
      </Choices>
      <Header value="28. Deliberately destroys others’ property" size="5" style="font-size:12px; font-weight:600; margin:6px 0 0 0;"/>
      <Choices name="symptom_28" toName="image" choice="single" showInline="true">
        <Choice value="0"/><Choice value="1"/><Choice value="2"/><Choice value="3"/><Choice value="Blank"/><Choice value="Not Available"/>
      </Choices>
      <Header value="29. Is fearful, anxious, or worried" size="5" style="font-size:12px; font-weight:600; margin:6px 0 0 0;"/>
      <Choices name="symptom_29" toName="image" choice="single" showInline="true">
        <Choice value="0"/><Choice value="1"/><Choice value="2"/><Choice value="3"/><Choice value="Blank"/><Choice value="Not Available"/>
      </Choices>
      <Header value="30. Is self-conscious or easily embarrassed" size="5" style="font-size:12px; font-weight:600; margin:6px 0 0 0;"/>
      <Choices name="symptom_30" toName="image" choice="single" showInline="true">
        <Choice value="0"/><Choice value="1"/><Choice value="2"/><Choice value="3"/><Choice value="Blank"/><Choice value="Not Available"/>
      </Choices>
      <Header value="31. Is afraid to try new things for fear of making mistakes" size="5" style="font-size:12px; font-weight:600; margin:6px 0 0 0;"/>
      <Choices name="symptom_31" toName="image" choice="single" showInline="true">
        <Choice value="0"/><Choice value="1"/><Choice value="2"/><Choice value="3"/><Choice value="Blank"/><Choice value="Not Available"/>
      </Choices>
      </View>

      <!-- Page 2: symptoms 32–35 + performance -->
      <View visibleWhen="choice-selected" whenTagName="visible_pages" whenChoiceValue="Page 2" style="border-left:3px solid #e3e6ec; padding-left:8px; margin-top:6px;">
      <Header value="Page 2" size="5" style="font-size:11px; color:#6b7280; margin:0 0 4px 0; text-transform:uppercase; letter-spacing:0.5px;"/>
      <Header value="Symptoms (continued)  (0=Never, 1=Occasionally, 2=Often, 3=Very Often)" size="4" style="font-size:14px; margin:12px 0 2px 0;"/>
      <Header value="32. Feels worthless or inferior" size="5" style="font-size:12px; font-weight:600; margin:6px 0 0 0;"/>
      <Choices name="symptom_32" toName="image" choice="single" showInline="true">
        <Choice value="0"/><Choice value="1"/><Choice value="2"/><Choice value="3"/><Choice value="Blank"/><Choice value="Not Available"/>
      </Choices>
      <Header value="33. Blames self for problems; feels guilty" size="5" style="font-size:12px; font-weight:600; margin:6px 0 0 0;"/>
      <Choices name="symptom_33" toName="image" choice="single" showInline="true">
        <Choice value="0"/><Choice value="1"/><Choice value="2"/><Choice value="3"/><Choice value="Blank"/><Choice value="Not Available"/>
      </Choices>
      <Header value="34. Feels lonely, unwanted, or unloved; complains that “no one loves him or her”" size="5" style="font-size:12px; font-weight:600; margin:6px 0 0 0;"/>
      <Choices name="symptom_34" toName="image" choice="single" showInline="true">
        <Choice value="0"/><Choice value="1"/><Choice value="2"/><Choice value="3"/><Choice value="Blank"/><Choice value="Not Available"/>
      </Choices>
      <Header value="35. Is sad, unhappy, or depressed" size="5" style="font-size:12px; font-weight:600; margin:6px 0 0 0;"/>
      <Choices name="symptom_35" toName="image" choice="single" showInline="true">
        <Choice value="0"/><Choice value="1"/><Choice value="2"/><Choice value="3"/><Choice value="Blank"/><Choice value="Not Available"/>
      </Choices>
      <Header value="Performance  (1=Excellent, 2=Above Average, 3=Average, 4=Somewhat of a Problem, 5=Problematic)" size="4" style="font-size:14px; margin:12px 0 2px 0;"/>
      <Header value="Academic Performance" size="5" style="font-size:12px; font-style:italic; margin:8px 0 0 0;"/>
      <Header value="36. Reading" size="5" style="font-size:12px; font-weight:600; margin:6px 0 0 0;"/>
      <Choices name="performance_36" toName="image" choice="single" showInline="true">
        <Choice value="1"/><Choice value="2"/><Choice value="3"/><Choice value="4"/><Choice value="5"/><Choice value="Blank"/><Choice value="Not Available"/>
      </Choices>
      <Header value="37. Mathematics" size="5" style="font-size:12px; font-weight:600; margin:6px 0 0 0;"/>
      <Choices name="performance_37" toName="image" choice="single" showInline="true">
        <Choice value="1"/><Choice value="2"/><Choice value="3"/><Choice value="4"/><Choice value="5"/><Choice value="Blank"/><Choice value="Not Available"/>
      </Choices>
      <Header value="38. Written expression" size="5" style="font-size:12px; font-weight:600; margin:6px 0 0 0;"/>
      <Choices name="performance_38" toName="image" choice="single" showInline="true">
        <Choice value="1"/><Choice value="2"/><Choice value="3"/><Choice value="4"/><Choice value="5"/><Choice value="Blank"/><Choice value="Not Available"/>
      </Choices>
      <Header value="Classroom Behavioral Performance" size="5" style="font-size:12px; font-style:italic; margin:8px 0 0 0;"/>
      <Header value="39. Relationship with peers" size="5" style="font-size:12px; font-weight:600; margin:6px 0 0 0;"/>
      <Choices name="performance_39" toName="image" choice="single" showInline="true">
        <Choice value="1"/><Choice value="2"/><Choice value="3"/><Choice value="4"/><Choice value="5"/><Choice value="Blank"/><Choice value="Not Available"/>
      </Choices>
      <Header value="40. Following directions" size="5" style="font-size:12px; font-weight:600; margin:6px 0 0 0;"/>
      <Choices name="performance_40" toName="image" choice="single" showInline="true">
        <Choice value="1"/><Choice value="2"/><Choice value="3"/><Choice value="4"/><Choice value="5"/><Choice value="Blank"/><Choice value="Not Available"/>
      </Choices>
      <Header value="41. Disrupting class" size="5" style="font-size:12px; font-weight:600; margin:6px 0 0 0;"/>
      <Choices name="performance_41" toName="image" choice="single" showInline="true">
        <Choice value="1"/><Choice value="2"/><Choice value="3"/><Choice value="4"/><Choice value="5"/><Choice value="Blank"/><Choice value="Not Available"/>
      </Choices>
      <Header value="42. Assignment completion" size="5" style="font-size:12px; font-weight:600; margin:6px 0 0 0;"/>
      <Choices name="performance_42" toName="image" choice="single" showInline="true">
        <Choice value="1"/><Choice value="2"/><Choice value="3"/><Choice value="4"/><Choice value="5"/><Choice value="Blank"/><Choice value="Not Available"/>
      </Choices>
      <Header value="43. Organizational skills" size="5" style="font-size:12px; font-weight:600; margin:6px 0 0 0;"/>
      <Choices name="performance_43" toName="image" choice="single" showInline="true">
        <Choice value="1"/><Choice value="2"/><Choice value="3"/><Choice value="4"/><Choice value="5"/><Choice value="Blank"/><Choice value="Not Available"/>
      </Choices>
      </View>

      <Header value="Comments" size="4" style="font-size:14px; margin:12px 0 2px 0;"/>
      <TextArea name="comments" toName="image" rows="3" maxSubmissions="1" placeholder="transcribe any comments written on the form (leave empty if none)"/>
    </View>
  </View>
</View>
