<!-- MoCA (Montreal Cognitive Assessment) v8.3  (Stage-2 extraction)
     Collects the score written in each domain point-box + total + MIS.
     Domain scores = radio Choices; Total & MIS = numeric TextArea. -->
<View>
  <View style="display:flex;">

    <!-- Left panel (stays in view): scanned page with zoom/pan/rotate -->
    <View style="flex:55%; align-self:flex-start; position:sticky; top:0; padding-right:1em;">
      <Image name="image" value="$image" zoom="true" zoomControl="true"
             rotateControl="true" width="100%"/>
    </View>

    <!-- Right panel (scrolls independently): extraction fields -->
    <View style="flex:45%; overflow-y:auto; max-height:90vh;">
      <Header value="MoCA — score extraction"/>
      <Text name="filename" value="File: $filename"/>
      <Text name="doc_id" value="Doc ID: $doc_id"/>

      <Header value="Visuospatial / Executive  (0–5)" size="5"/>
      <Choices name="visuospatial_executive" toName="image" choice="single" showInline="true" required="true">
        <Choice value="0"/><Choice value="1"/><Choice value="2"/><Choice value="3"/>
        <Choice value="4"/><Choice value="5"/>
        <Choice value="blank"/><Choice value="illegible"/>
      </Choices>

      <Header value="Naming  (0–3)" size="5"/>
      <Choices name="naming" toName="image" choice="single" showInline="true" required="true">
        <Choice value="0"/><Choice value="1"/><Choice value="2"/><Choice value="3"/>
        <Choice value="blank"/><Choice value="illegible"/>
      </Choices>

      <Header value="Attention" size="4"/>
      <Header value="Digit span, forward + backward  (0–2)" size="5"/>
      <Choices name="attention_digitspan" toName="image" choice="single" showInline="true" required="true">
        <Choice value="0"/><Choice value="1"/><Choice value="2"/>
        <Choice value="blank"/><Choice value="illegible"/>
      </Choices>
      <Header value="Vigilance, tap on letter A  (0–1)" size="5"/>
      <Choices name="attention_vigilance" toName="image" choice="single" showInline="true" required="true">
        <Choice value="0"/><Choice value="1"/>
        <Choice value="blank"/><Choice value="illegible"/>
      </Choices>
      <Header value="Serial 7 subtraction  (0–3)" size="5"/>
      <Choices name="attention_serial7" toName="image" choice="single" showInline="true" required="true">
        <Choice value="0"/><Choice value="1"/><Choice value="2"/><Choice value="3"/>
        <Choice value="blank"/><Choice value="illegible"/>
      </Choices>

      <Header value="Language" size="4"/>
      <Header value="Sentence repetition  (0–2)" size="5"/>
      <Choices name="language_repetition" toName="image" choice="single" showInline="true" required="true">
        <Choice value="0"/><Choice value="1"/><Choice value="2"/>
        <Choice value="blank"/><Choice value="illegible"/>
      </Choices>
      <Header value="Fluency, letter B  (0–1)" size="5"/>
      <Choices name="language_fluency" toName="image" choice="single" showInline="true" required="true">
        <Choice value="0"/><Choice value="1"/>
        <Choice value="blank"/><Choice value="illegible"/>
      </Choices>

      <Header value="Abstraction  (0–2)" size="5"/>
      <Choices name="abstraction" toName="image" choice="single" showInline="true" required="true">
        <Choice value="0"/><Choice value="1"/><Choice value="2"/>
        <Choice value="blank"/><Choice value="illegible"/>
      </Choices>

      <Header value="Delayed Recall  (0–5)" size="5"/>
      <Choices name="delayed_recall" toName="image" choice="single" showInline="true" required="true">
        <Choice value="0"/><Choice value="1"/><Choice value="2"/><Choice value="3"/>
        <Choice value="4"/><Choice value="5"/>
        <Choice value="blank"/><Choice value="illegible"/>
      </Choices>

      <Header value="Orientation  (0–6)" size="5"/>
      <Choices name="orientation" toName="image" choice="single" showInline="true" required="true">
        <Choice value="0"/><Choice value="1"/><Choice value="2"/><Choice value="3"/>
        <Choice value="4"/><Choice value="5"/><Choice value="6"/>
        <Choice value="blank"/><Choice value="illegible"/>
      </Choices>

      <Header value="Total" size="4"/>
      <Header value="Total Score  (0–30)" size="5"/>
      <TextArea name="total_score" toName="image" rows="1" maxSubmissions="1" required="true"
                placeholder="0–30  (type NA if blank/illegible)"/>
    </View>
  </View>
</View>
